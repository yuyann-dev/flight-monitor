# 复制为 .env 并填入真实值
SECRET_KEY=please-change-to-a-random-string

# SMTP 发件邮箱
SMTP_USER=your_smtp_account@example.com
SMTP_PASSWORD=your_smtp_auth_code
SMTP_FROM=your_smtp_account@example.com

# 服务端口
PORT=8787

# 飞常准 MCP（可选，留空则仅使用飞猪；在 https://cmcp.variflight.com 注册获取）
VARIFLIGHT_MCP_KEY=
# 飞常准最小调用间隔（小时），用于把每月免费额度控制在 100 次内；默认 15 小时
VARIFLIGHT_MIN_INTERVAL_HOURS=15
# 系统主人邮箱：主人有活跃任务时，飞常准额度仅服务于主人
OWNER_EMAIL=
