[Unit]
Description=Flight Monitor Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/flight-monitor
EnvironmentFile=/opt/flight-monitor/.env
ExecStart=/opt/flight-monitor/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=5
CPUQuota=40%
MemoryMax=1G

[Install]
WantedBy=multi-user.target
